# Normalize text files while preserving binary assets.
* text=auto

*.cs text eol=lf diff=csharp
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.json text eol=lf
*.md text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.inputactions text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.ttf binary
*.otf binary
*.unitypackage binary
