    characterSetSelectionMode: 7
    characterSequence: "\u75C5\u6BD2\u9897\u7C92\u7531\u6B63\u5E38\u7684\u8EAB\u4F53\u7EC6\u80DE\u5F02\u5E38\u5206\u88C2\u800C\u6765\uFF0C\u5E76\u4E14\u5728\u4E0D\u65AD\u589E\u6B96\u8FC7\u7A0B\u4E2D\u53D1\u751F\u4E86\u53D8\u5F02\u6CA1\u5B66\u8FC7\u4E0D\u77E5\u9053\u88AB\u611F\u67D3\u7684\u6B63\u5E38\u8EAB\u4F53\u7EC6\u80DE\uFF0C\u5E76\u4E14\u5728\u75C5\u53D8\u8FC7\u7A0B\u4E2D\u9057\u4F20\u7269\u8D28\u53D1\u751F\u4E86\u6539\u53D8\uFF0C\u5BF9\u4EBA\u4F53\u6709\u66F4\u5927\u7684\u4F24\u5BB3\u7531\u6B63\u5E38\u7684\u8EAB\u4F53\u7EC6\u80DE\u5F02\u5E38\u5206\u88C2\u800C\u6765\uFF0C\u4F1A\u5728\u4EBA\u4F53\u5185\u65E0\u9650\u589E\u6B96\u7531\u86CB\u767D\u8D28\u5916\u58F3\u5305\u88F9\u7684\u5916\u6765\u9057\u4F20\u7269\u8D28\uFF0C\u662F\u6700\u5E38\u89C1\u7684\u4E00\u79CD\u6CBB\u75C5\u56E0\u7D20\u88AB\u611F\u67D3\u7684\u6B63\u5E38\u8EAB\u4F53\u7EC6\u80DE\u80BF\u7624\u53D8\u5F02\u8C03\u8282\u666E\u901A\u611F\u67D3\u7EC6\u80DE\u89E3\u9501\u72B6\u6001\u771F\u602A\u7269\u81EA\u52A8\u56FE\u9274\u540D\u79F0\u63CF\u8FF0\u51FB\u6740\u6570\u8FD4\u56DE\u4E3B\u754C\u9762\u8BBE\u7F6E\u97F3\u6548\u97F3\u4E50\u97F3\u91CF\u6682\u505C\u7EE7\u7EED\u9000\u51FA\u786E\u8BA4\u53D6\u6D88\u52A0\u8F7D\u4E2D\u8BF7\u7A0D\u5019\u9519\u8BEF\u8B66\u544A\u63D0\u793A\u6210\u529F\u5931\u8D25\u7B49\u7EA7\u7ECF\u9A8C\u503C\u751F\u547D\u503C\u653B\u51FB\u529B\u9632\u5FA1\u529B\u901F\u5EA6\u66B4\u51FB\u7387\u95EA\u907F\u7387\u547D\u4E2D\u7387\u6280\u80FD\u51B7\u5374\u65F6\u95F4\u6D88\u8017\u6548\u679C\u8303\u56F4\u76EE\u6807\u7C7B\u578B\u88AB\u52A8\u4E3B\u52A8\u589E\u76CA\u51CF\u76CA\u63A7\u5236\u4F24\u5BB3\u6CBB\u7597\u62A4\u76FE\u53EC\u5524\u4F20\u9001\u4F4D\u79FB\u9690\u8EAB\u65E0\u654C\u51C0\u5316\u9A71\u6563\u590D\u6D3B\u91CD\u751F\u6389\u843D\u5956\u52B1\u4EFB\u52A1\u6210\u5C31\u6392\u884C\u699C\u597D\u53CB\u804A\u5929\u90AE\u4EF6\u5546\u5E97\u80CC\u5305\u88C5\u5907\u5F3A\u5316\u5408\u6210\u5206\u89E3\u51FA\u552E\u8D2D\u4E70\u5237\u65B0\u91CD\u7F6E\u4FDD\u5B58\u8BFB\u53D6\u5220\u9664\u65B0\u5EFA\u7F16\u